# ===== .env untuk VM (letakkan di /opt/wagagent/.env) =====

# Image di Docker Hub yang akan di-pull (ganti USERNAME).
WAGAGENT_IMAGE=docker.io/USERNAME/wagagent:latest

# --- Konfigurasi aplikasi (sama seperti .env.example di root) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-5-5
OWNER_JIDS=
DEFAULT_SUMMARY_TIME=21:00
TZ=Asia/Jakarta
DEFAULT_LANGUAGE=id
RETENTION_HOURS=48
COMMAND_PREFIX=!
LOG_LEVEL=info
DATA_DIR=/app/data
