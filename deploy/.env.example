# ===== .env untuk VM (letakkan di /opt/wagagent/.env) =====

# Image di Docker Hub yang akan di-pull (ganti USERNAME).
WAGAGENT_IMAGE=docker.io/USERNAME/wagagent:latest

# --- Konfigurasi aplikasi (sama seperti .env.example di root) ---
# Provider LLM: "anthropic" (Claude) atau "openai" (Qwen lokal / endpoint kompatibel-OpenAI).
LLM_PROVIDER=anthropic

# Jika pakai Claude:
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-5-5

# Jika pakai endpoint kompatibel-OpenAI (LLM_PROVIDER=openai):
#   Qwen lokal (vLLM): LLM_BASE_URL=http://IP_VM_MODEL:8000/v1   LLM_MODEL=Qwen/Qwen3-1.7B
#   9Router:           LLM_BASE_URL=http://IP_9ROUTER:20128/v1   LLM_MODEL=kr/claude-sonnet-4.5
#     (9Router di host yang sama: LLM_BASE_URL=http://host.docker.internal:20128/v1)
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# LLM_MAX_INPUT_CHARS=0

OWNER_JIDS=
DEFAULT_SUMMARY_TIME=21:00
TZ=Asia/Jakarta
DEFAULT_LANGUAGE=id
RETENTION_HOURS=48
COMMAND_PREFIX=!
LOG_LEVEL=info
DATA_DIR=/app/data
