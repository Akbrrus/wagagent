# ===== WagAgent Konfigurasi =====

# --- Pilih provider LLM untuk ringkasan ---
# "anthropic" = Claude (butuh ANTHROPIC_API_KEY)
# "openai"    = endpoint kompatibel-OpenAI, mis. Qwen lokal di vLLM/Ollama (butuh LLM_BASE_URL + LLM_MODEL)
LLM_PROVIDER=anthropic

# --- Jika LLM_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-5-5

# --- Jika LLM_PROVIDER=openai (endpoint kompatibel-OpenAI) ---
# 9Router satu compose (DEFAULT, service name "9router"): LLM_BASE_URL=http://9router:20128/v1
# 9Router di VM lain:                                     LLM_BASE_URL=http://IP_9ROUTER:20128/v1
# Qwen lokal (vLLM):   LLM_BASE_URL=http://IP_VM_MODEL:8000/v1    LLM_MODEL=Qwen/Qwen3-1.7B
# Ollama:              LLM_BASE_URL=http://IP_VM_MODEL:11434/v1   LLM_MODEL=qwen3:1.7b
LLM_BASE_URL=http://9router:20128/v1
LLM_MODEL=kr/claude-sonnet-4.5
# Banyak server lokal tidak butuh key; isi bila server Anda mewajibkan (vLLM: nilai --api-key).
LLM_API_KEY=
# Batas karakter transkrip yang dikirim (0 = tanpa batas). Untuk model konteks kecil
# seperti Qwen 1.7B, set mis. 12000 agar tidak melebihi context window.
LLM_MAX_INPUT_CHARS=0

# Nomor yang boleh menjalankan perintah "!", dipisah koma (tanpa + atau spasi).
# Contoh: OWNER_JIDS=6281234567890,6289876543210
OWNER_JIDS=

# Izinkan nomor BOT (yang discan) memerintah dirinya sendiri?
#   true  = nomor bot bisa ketik perintah ke diri sendiri (default).
#   false = pola "bot khusus": perintah HANYA dari OWNER_JIDS (nomor lain).
# Untuk pola bot khusus: set false DAN isi OWNER_JIDS dengan nomor Anda.
ALLOW_SELF_COMMANDS=true

# Jam ringkasan harian otomatis default (format 24 jam HH:MM). Bisa diubah lewat !settime.
DEFAULT_SUMMARY_TIME=21:00

# Timezone IANA. Bisa diubah lewat !settz.
TZ=Asia/Jakarta

# Bahasa ringkasan default: id atau en. Bisa diubah lewat !setlang.
DEFAULT_LANGUAGE=id

# Berapa lama pesan disimpan di buffer (jam).
RETENTION_HOURS=48

# Prefix perintah.
COMMAND_PREFIX=!

# Level log: debug | info | warn | error
LOG_LEVEL=info

# Lokasi folder data di dalam container (biarkan default bila pakai Docker).
DATA_DIR=/app/data

# ===== Docker / 9Router (opsional) =====

# Password login dashboard 9Router (default image: 123456). Disarankan diganti.
NINEROUTER_PASSWORD=123456
# NINEROUTER_JWT_SECRET=ganti-string-acak-panjang
# NINEROUTER_IMAGE=decolua/9router:latest

# HANYA untuk mode PULL (jalur CI/CD, ambil image dari Docker Hub).
# Mode BUILD (docker compose up -d --build) TIDAK butuh ini — biarkan kosong/komentar.
# WAGAGENT_IMAGE=docker.io/USERNAME/wagagent:latest
